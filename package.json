{
  "name": "sagekept",
  "version": "1.9.8",
  "license": "AGPL-3.0-only",
  "scripts": {
    "ng": "ng",
    "dev": "node -e \"const fs=require('fs'),cp=require('child_process');if(!fs.existsSync('dist/keep/index.html')){cp.execSync('npm run build',{stdio:'inherit'});}\" && node server/server.js",
    "start": "node server/server.js",
    "client": "concurrently --kill-others \"npm run translations:watch\" \"ng serve --host 0.0.0.0 --port 6767 --proxy-config proxy.conf.json\"",
    "api": "nodemon --no-deprecation server/server.js",
    "build": "npm run translations:prepare && ng build && npm run purgecss",
    "lint": "tsc -p tsconfig.app.json --noEmit",
    "purgecss": "purgecss -c purgecss.config.js",
    "watch": "concurrently --kill-others \"npm run translations:watch\" \"ng build --watch --configuration development\"",
    "translations:check": "node scripts/translations.mjs check",
    "translations:init": "node scripts/translations.mjs init",
    "translations:prepare": "node scripts/translations.mjs export-web --out src/assets/i18n",
    "translations:watch": "node scripts/translations.mjs export-web --out src/assets/i18n --watch",
    "preclient": "npm run translations:prepare",
    "prewatch": "npm run translations:prepare",
    "preng": "npm run translations:prepare"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.12",
    "@angular/common": "^21.2.12",
    "@angular/compiler": "^21.2.12",
    "@angular/core": "^21.2.12",
    "@angular/forms": "^21.2.12",
    "@angular/platform-browser": "^21.2.12",
    "@angular/platform-browser-dynamic": "^21.2.12",
    "@angular/router": "^21.2.12",
    "@capacitor/core": "^8.3.4",
    "@img/sharp-wasm32": "0.35.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@ngx-translate/core": "^18.1.0",
    "@noble/hashes": "2.4.0",
    "@popperjs/core": "^2.11.5",
    "@types/jszip": "^3.4.0",
    "@zip.js/zip.js": "2.24.0",
    "adm-zip": "^0.6.1",
    "bricks.js": "^1.8.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "csrf-sync": "^4.2.1",
    "dompurify": "^3.4.17",
    "express": "^4.22.1",
    "express-session": "^1.19.0",
    "heic-to": "1.6.7",
    "highlight.js": "11.12.0",
    "htmlparser2": "10.1.0",
    "jszip": "^3.10.1",
    "leaflet": "1.9.4",
    "multer": "^2.5.0",
    "node-snackbar": "^0.1.16",
    "nodemailer": "^10.2.1",
    "openid-client": "^6.8.8",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.5.0",
    "sanitize-html": "^2.18.1",
    "sharp": "0.35.5",
    "sqlite3": "5.1.7",
    "timepicker-ui": "^4.3.0",
    "tslib": "^2.3.0",
    "unzipper": "^0.12.3",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^3.25.76",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.10",
    "@angular/cli": "~21.2.10",
    "@angular/compiler-cli": "^21.2.12",
    "@types/leaflet": "^1.9.22",
    "nodemon": "^3.1.9",
    "purgecss": "^4.1.3",
    "typescript": "~5.9.3"
  }
}
